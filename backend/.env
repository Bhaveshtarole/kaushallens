# Use cpu on a normal laptop. Change to cuda only if PyTorch/CUDA detects an NVIDIA GPU.
SKILLGUARD_DEVICE=cpu
SKILLGUARD_CONFIDENCE_THRESHOLD=0.45
SKILLGUARD_NMS_IOU_THRESHOLD=0.50
SKILLGUARD_SAMPLE_EVERY_SECONDS=1.0
SKILLGUARD_WINDOW_SECONDS=10
SKILLGUARD_TOLERANCE_PERCENT=0.15
SKILLGUARD_TOLERANCE_MIN_PEOPLE=2
SKILLGUARD_STORAGE_DIR=storage
# Comma-separated list of browser origins. Do not use * outside a demo.
SKILLGUARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
